<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: imported cookies never go to cloud backup or a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies/"/>
    </device-transfer>
</data-extraction-rules>
